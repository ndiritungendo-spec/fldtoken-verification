import fs from "fs";
import { ethers } from "hardhat";

async function main() {
  const FluidToken = await ethers.getContractFactory("FluidToken");
  const token = await FluidToken.deploy("Fluid Token", "FLUID");

  await token.deployed();

  console.log("FluidToken deployed to:", token.address);

  // Save deployment info
  const deployment = {
    address: token.address,
    constructorArgs: ["Fluid Token", "FLUID"],
  };
  fs.writeFileSync("deployments/polygon.json", JSON.stringify(deployment, null, 2));
}

main().catch((error) => {
  console.error(error);
  process.exit(1);
});